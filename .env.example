# Docker Compose 用設定。ローカルの Expo は frontend/.env を使用します。
EXPO_PUBLIC_API_URL=http://localhost:8000
# ブラウザは同一オリジンのAPI経由で接続。Expo Goの接続先は上の設定を使用。
EXPO_PUBLIC_WEB_API_URL=/api
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# ローカル開発用 PostgreSQL。アプリ用のテーブルは作成しません。
POSTGRES_DB=walking_app
POSTGRES_USER=walking_app
POSTGRES_PASSWORD=walking_app_dev
POSTGRES_PORT=5432

# JWT認証設定（本番環境では変更すること）
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
