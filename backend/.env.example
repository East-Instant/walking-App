CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Docker内のDB接続先。Compose起動時の設定はルート.envとcompose.yamlで管理。
DATABASE_URL=postgresql://walking_app:walking_app_dev@db:5432/walking_app
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# ローカル直接起動時だけ、上記URLのdbをlocalhost、ポートを公開ポートに変更。
# --env-file .env を指定。DB作成は alembic upgrade head を実行。
# Optional: private photo directory (default: backend/data/photos)
# PHOTO_STORAGE_DIR=/absolute/path/to/photos
